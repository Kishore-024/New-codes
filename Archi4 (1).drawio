        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% --- Top Layer: Client Area (Blue Theme like image_cdf09e.png) ---\n    subgraph ClientLayer [\&quot;&lt;b&gt;CLAUDE DESKTOP (MCP CLIENT)&lt;/b&gt;\&quot;]\n        Block1(\&quot;&lt;b&gt;END USER&lt;/b&gt;&lt;br/&gt;• User interacts with Claude&lt;br/&gt;• OAuth Login Flow\&quot;)\n        Block2(\&quot;&lt;b&gt;TOKEN MANAGEMENT&lt;/b&gt;&lt;br/&gt;• Stores Access Token&lt;br/&gt;• Discovers MCP Tools&lt;br/&gt;• Calls MCP Server Tools\&quot;)\n    end\n    style ClientLayer fill:#EEF2FF,stroke:#312E81,stroke-width:2px,color:#1E1B4B\n\n    %% --- Identity Boundary (Purple Theme) ---\n    subgraph IdentityLayer [\&quot;&lt;b&gt;KEYCLOAK (IDS / Identity Server) - Realm: LNT&lt;/b&gt;\&quot;]\n        Block3(\&quot;&lt;b&gt;AUTHENTICATION HUB&lt;/b&gt;&lt;br/&gt;• User Authentication &amp; Management&lt;br/&gt;• Roles &amp; Permissions Management&lt;br/&gt;• JWT Token Generation &amp; JWKS Endpoint\&quot;)\n    end\n    style IdentityLayer fill:#F5F3FF,stroke:#4338CA,stroke-width:2px,color:#2E1065\n\n    %% --- Mid Layer: Unified Server Container (Teal/Blue Core Theme like image_cdf09e.png) ---\n    subgraph ServerLayer [\&quot;&lt;b&gt;FASTMCP SERVER (MCP SERVER) - Transport Layer: HTTP / SSE&lt;/b&gt;\&quot;]\n        \n        subgraph ToolLayer [\&quot;&lt;b&gt;Tool Layer&lt;/b&gt;\&quot;]\n            B4_1(\&quot;• search_company()&lt;br/&gt;• get_company_metrics()\&quot;)\n            B4_2(\&quot;• get_financial_summary()&lt;br/&gt;• get_portfolio_data()\&quot;)\n        end\n        \n        subgraph ServiceLayer [\&quot;&lt;b&gt;Service Layer&lt;/b&gt;\&quot;]\n            B4_3(\&quot;• API orchestration&lt;br/&gt;• Response transformation&lt;br/&gt;• Data aggregation\&quot;)\n        end\n        \n        subgraph ClientLayer2 [\&quot;&lt;b&gt;API Client Layer&lt;/b&gt;\&quot;]\n            B4_4(\&quot;• Reads Bearer Token&lt;br/&gt;• Forwards Token&lt;br/&gt;• Calls Backend APIs&lt;br/&gt;&lt;b&gt;⚠️ NO JWT VALIDATION HERE&lt;/b&gt;\&quot;)\n        end\n\n    end\n    style ServerLayer fill:#F0FDFA,stroke:#0F766E,stroke-width:2px,color:#115E59\n    style ToolLayer fill:#FFFFFF,stroke:#14B8A6,stroke-width:1.5px,color:#0F766E\n    style ServiceLayer fill:#FFFFFF,stroke:#14B8A6,stroke-width:1.5px,color:#0F766E\n    style ClientLayer2 fill:#FFFFFF,stroke:#14B8A6,stroke-width:1.5px,color:#0F766E\n\n    %% --- Lower Layer: Protected Backend (Amber Theme) ---\n    subgraph BackendLayer [\&quot;&lt;b&gt;INSIGHT BACKEND APIs (RESOURCE SERVER)&lt;/b&gt;\&quot;]\n        Block5(\&quot;&lt;b&gt;~ 30 PROTECTED APIs&lt;/b&gt;&lt;br/&gt;• Company APIs | KPI APIs&lt;br/&gt;• Revenue APIs | Portfolio APIs&lt;br/&gt;• Financial APIs\&quot;)\n        Block5_Resp(\&quot;&lt;b&gt;RESPONSIBILITIES&lt;/b&gt;&lt;br/&gt;• Validate JWT&lt;br/&gt;• Check Roles &amp; Authorize User&lt;br/&gt;• Return Business Data\&quot;)\n    end\n    style BackendLayer fill:#FEF3C7,stroke:#B45309,stroke-width:2px,color:#78350F\n    style Block5 fill:#FFFFFF,stroke:#D97706,stroke-width:1px,color:#78350F\n    style Block5_Resp fill:#FFFFFF,stroke:#D97706,stroke-width:1px,color:#78350F\n\n    %% --- Verification Target (Terminal Step) ---\n    subgraph ValidationLayer [\&quot;&lt;b&gt;TOKEN VALIDATION HUB (KEYCLOAK)&lt;/b&gt;\&quot;]\n        Block6(\&quot;• Signature Validation&lt;br/&gt;• Issuer Validation&lt;br/&gt;• Audience Validation&lt;br/&gt;• Role Verification\&quot;)\n    end\n    style ValidationLayer fill:#F5F3FF,stroke:#4338CA,stroke-width:2px,color:#2E1065\n    style Block6 fill:#FFFFFF,stroke:#6366F1,stroke-width:1px,color:#2E1065\n\n    %% --- Internal Block Style Elements to force Rounded Shapes ---\n    style Block1 fill:#FFFFFF,stroke:#4F46E5,stroke-width:1px\n    style Block2 fill:#FFFFFF,stroke:#4F46E5,stroke-width:1px\n    style Block3 fill:#FFFFFF,stroke:#6366F1,stroke-width:1px\n    style B4_1 fill:#FFFFFF,stroke:#14B8A6,stroke-width:1px\n    style B4_2 fill:#FFFFFF,stroke:#14B8A6,stroke-width:1px\n    style B4_3 fill:#FFFFFF,stroke:#14B8A6,stroke-width:1px\n    style B4_4 fill:#FFFFFF,stroke:#14B8A6,stroke-width:1px\n\n    %% --- Clean Architecture Flow Connections ---\n    ClientLayer --&gt;|1. OAuth2 / OIDC Login| IdentityLayer\n    IdentityLayer --&gt;|2. JWT Access Token| ServerLayer\n    ServerLayer --&gt;|3. Authorization: Bearer Token| BackendLayer\n    BackendLayer --&gt;|4. Introspect / Verify Token| ValidationLayer\n\n    %% --- Arrow Theme Overrides ---\n    linkStyle default stroke:#475569,stroke-width:2px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Fi86lP1ZOvhr7QRpKTfx-1">
